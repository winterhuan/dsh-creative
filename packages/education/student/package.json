{
  "name": "@winterhuan/dsh-student",
  "version": "0.1.0",
  "description": "Short daily learning, confirmed curricula and spaced mistake review for primary-school students",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winterhuan/dsh-creative.git",
    "directory": "packages/education/student"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./agent": {
      "types": "./lib/types/agent.d.ts",
      "default": "./lib/agent.js"
    }
  },
  "files": [
    "lib",
    "knowledge",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "~1.0.5-alpha.1",
    "@deepseek-ai/dsh-agent-instructions": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-command-compact": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-persona": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-time-context": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-present": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-web": "0.2.1-alpha.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs-local": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-alpha.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "build": "tsc -b tsconfig.host.json tsconfig.client.json && tsdown --config-loader native",
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json",
    "test": "vitest run --root ../../.. --config vitest.config.ts packages/education/student/tests"
  }
}
