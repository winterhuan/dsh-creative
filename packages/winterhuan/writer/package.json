{
  "name": "@winterhuan/dsh-writer",
  "version": "0.1.0",
  "description": "Thin DSH writing mode that mounts oh-story skills and a Dashboard-aligned workspace sidebar",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winterhuan/dsh-creative.git",
    "directory": "packages/winterhuan/writer"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "~1.0.5",
    "@deepseek-ai/dsh-agent-instructions": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.5",
    "@deepseek-ai/dsh-command-compact": "0.2.1-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.5",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.1-rc.5",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.5",
    "@deepseek-ai/dsh-time-context": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-jobs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-present": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-subagent-control": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-web": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-workflow": "0.2.1-rc.5",
    "@deepseek-ai/dsh-workflow-ptc": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.5",
    "@types/react": "18.3.28",
    "react": "18.3.1"
  },
  "scripts": {
    "build": "tsc -b tsconfig.host.json tsconfig.client.json && tsdown --config-loader native",
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json",
    "test": "vitest run --root ../../.. --config vitest.config.ts packages/winterhuan/writer/tests"
  }
}
