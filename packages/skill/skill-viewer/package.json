{
  "name": "@winterhuan/dsh-skill-viewer",
  "description": "Read-only skill catalog and body Remote for the skill viewer",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winterhuan/dsh-creative.git",
    "directory": "packages/skill/skill-viewer"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "@winterhuan/dsh-client-ui-skill-viewer": "workspace:*",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.1",
    "@deepseek-ai/cordis": "~4.0.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
